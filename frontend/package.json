{
  "name": "businessos-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/restore-dist-gitkeep.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:postbuild": "node --test scripts/restore-dist-gitkeep.node.mjs",
    "quality:crap": "node ../scripts/repo-quality-check.mjs",
    "quality:crap:update": "node ../scripts/repo-quality-check.mjs --update-baseline"
  },
  "dependencies": {
    "fuse.js": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  }
}
